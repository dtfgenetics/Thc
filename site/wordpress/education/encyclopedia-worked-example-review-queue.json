{
  "schemaVersion": 1,
  "name": "THC Encyclopedia Worked Example Review Queue",
  "purpose": "Controlled reviewer workflow for deciding whether an internal worked example is scientifically, instructionally, and publication-ready for learner-facing encyclopedia pages.",
  "sourceOfTruth": {
    "examples": "content/encyclopedia/worked-examples-v1.json",
    "lessons": "content/encyclopedia/volume-*/lessons and draft lesson collections",
    "approvalRule": "Worked examples remain hidden unless the canonical example record has learnerFacingApproved=true and complete independent-review approval metadata."
  },
  "statusValues": [
    "pending",
    "in-review",
    "changes-requested",
    "approved",
    "rejected"
  ],
  "reviewChecklistDefinition": {
    "scientificClaimReview": "Reasoning steps are consistent with the canonical lesson and do not add unsupported causal or quantitative claims.",
    "sourceAnchorReview": "Canonical lesson source notes adequately support the scientific and instructional claims used by the example.",
    "measurementLogicReview": "Evidence-to-collect and verification steps use appropriate measurements, sampling, units, and comparison logic.",
    "uncertaintyBoundaryReview": "Applicability limits, competing explanations, and uncertainty are explicit and proportionate to the evidence.",
    "instructionalClarityReview": "Scenario and reasoning path are understandable, sequenced, and useful to a learner without requiring hidden assumptions.",
    "safetyLegalBoundaryReview": "Example does not imply unlawful pesticide use, unsafe handling, medical advice, or unsupported universal operating targets.",
    "publicCopyReview": "Learner-facing wording is concise, accessible, non-prescriptive, and suitable for the encyclopedia UI."
  },
  "releaseGate": {
    "requiredStatus": "approved",
    "requiredChecklistTrue": [
      "scientificClaimReview",
      "sourceAnchorReview",
      "measurementLogicReview",
      "uncertaintyBoundaryReview",
      "instructionalClarityReview",
      "safetyLegalBoundaryReview",
      "publicCopyReview"
    ],
    "requiredMetadata": [
      "reviewer",
      "reviewedAt",
      "decisionNotes"
    ],
    "mutationTarget": "content/encyclopedia/worked-examples-v1.json",
    "resultingFields": {
      "learnerFacingApproved": true,
      "reviewControl.independentReviewStatus": "approved",
      "reviewControl.approvedForLearnerFacingAt": "reviewedAt",
      "reviewControl.approvedBy": "reviewer"
    }
  },
