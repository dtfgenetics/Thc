# Shared DTF cultivation/tool ES modules must be served with a JavaScript MIME type.
# Keep this scoped to /assets/ so WordPress-owned routes remain unaffected.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
