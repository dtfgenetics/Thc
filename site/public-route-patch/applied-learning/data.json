  "measurement": {
    "id": "ALMEAS-SENSOR-PLACEMENT-001",
    "version": "0.1.0",
    "status": "draft",
    "title": "Representative Canopy Sensor Placement",
    "summary": "Use multiple crop-zone readings to distinguish representative environmental evidence from a convenient but potentially biased single sensor location.",
    "competencyIds": [
      "COMP-ENV-VPD-001"
    ],
    "objectiveIds": [
      "LO-ENV-VPD-001"
    ],
    "referenceIds": [
      "REF-VPD-002"
    ],
    "canonicalSources": [
      "LESSON-ENV-VPD-001",
      "CLAIM-ENV-VPD-001"
    ],
    "steps": [
      {
        "id": "map",
        "instruction": "Identify at least three crop-zone measurement positions and record why each position is representative or potentially biased.",
        "evidence": "location notes"
      },
      {
        "id": "measure",
        "instruction": "Record temperature and relative humidity at each position using the same units and time window.",
        "evidence": "three paired readings"
      },
      {
        "id": "context",
        "instruction": "Record sensor identifier, height/zone, timestamp, nearby equipment influence, and whether leaf temperature was measured or assumed.",
        "evidence": "measurement context"
      },
      {
        "id": "compare",
        "instruction": "Compare the spatial pattern before making a room-wide interpretation. State what additional plant, airflow, or root-zone evidence would reduce uncertainty.",
        "evidence": "short interpretation"
      }
    ],
    "evidenceFields": [
      {
        "id": "temperatureC",
        "label": "Air temperature",
        "type": "number",
        "unit": "°C",
        "required": true
      },
      {
        "id": "relativeHumidityPct",
        "label": "Relative humidity",
        "type": "number",
        "unit": "%",
        "required": true
      },
      {
        "id": "sensorLocation",
        "label": "Sensor/crop-zone location",
        "type": "text",
        "unit": null,
        "required": true
      },
      {
        "id": "timestamp",
        "label": "Measurement timestamp",
        "type": "timestamp",
        "unit": null,
        "required": true
      },
      {
        "id": "biasNotes",
        "label": "Potential local bias or equipment influence",
        "type": "text",
        "unit": null,
        "required": true
      }
    ],
    "safetyBoundary": "This activity teaches measurement quality and interpretation. It does not authorize HVAC, electrical, compressed-gas, pesticide, or other controlled equipment/service work, and it does not define universal cultivation targets."
  },
  "calculator": {
    "id": "ALCALC-DLI-001",
    "version": "0.1.0",
    "status": "draft",
    "title": "Crop Math: DLI from PPFD and Photoperiod",
    "summary": "Calculate daily light integral from representative PPFD and the actual photoperiod while keeping intensity, distribution and environmental context visible.",
    "calculation": "dli-from-ppfd",
    "competencyIds": [
      "COMP-LIGHT-001"
    ],
    "objectiveIds": [
      "LO-LIGHT-DLI-003"
    ],
    "referenceIds": [
      "REF-LIGHT-001",
      "REF-PURDUE-DLI-238"
    ],
    "canonicalSources": [
      "LESSON-LIGHT-DLI-003"
    ],
    "inputFields": [
      {
        "id": "ppfdUmolM2S",
        "label": "Representative PPFD",
        "unit": "µmol/m²/s",
        "min": 0,
        "max": 5000
      },
      {
        "id": "photoperiodHours",
        "label": "Photoperiod",
        "unit": "hours/day",
        "min": 0.01,
        "max": 24
      }
    ],
    "output": {
      "label": "Daily light integral",
      "unit": "mol/m²/day"
    },
    "limitations": [
      "The result is a photon-dose calculation, not a universal cultivation target.",
      "Equal DLI can result from different PPFD/photoperiod combinations and does not prove equal biological response.",
      "Use representative canopy PPFD rather than an isolated peak reading.",
      "Interpret the result with spectrum, crop stage, temperature, water status, carbon dioxide and plant response."
    ]
  },
  "differential": {
    "id": "ALDIFF-YELLOWING-001",
    "version": "0.1.0",
    "status": "draft",
    "title": "Same Symptom, Different Cause: Yellowing Leaves",
    "summary": "Practice separating a visible yellowing pattern from competing nutritional, root-zone and environmental explanations before choosing the next evidence to collect.",
    "observedPattern": "Older lower leaves are yellowing while newer growth remains comparatively greener.",
    "competencyIds": [
      "COMP-NUTRITION-001",
      "COMP-PLANT-BIO-001"
    ],
    "referenceIds": [
      "REF-NUTRIENT-DEFICIENCY-001",
      "REF-NUTRITION-001",
      "REF-PLANT-BIO-001"
    ],
    "canonicalSources": [
      "LESSON-NUTRITION-001",
      "LESSON-PLANT-BIO-001"
    ],
    "hypotheses": [
      {
        "id": "low-or-limited-nutrient-availability",
        "label": "Low supply or limited nutrient availability",
        "whyPlausible": "A tissue-age pattern can be consistent with a mobile-nutrient limitation, but the visual pattern alone is not proof.",
        "evidenceThatRaisesConfidence": [
          "feed/source analysis shows insufficient supply",
          "root-zone pH trend supports reduced availability",
          "pattern progresses consistently across matched plants"
        ],
        "evidenceThatLowersConfidence": [
          "root-zone EC is already excessive",
          "roots show clear oxygen/water stress",
          "pattern is localized to a heat or airflow anomaly"
        ]
      },
      {
        "id": "root-zone-stress",
        "label": "Root-zone water, aeration or salinity stress",
        "whyPlausible": "Root dysfunction can limit uptake even when nutrients are present in the feed.",
        "evidenceThatRaisesConfidence": [
          "abnormal root-zone moisture or aeration history",
          "elevated root-zone EC",
          "root discoloration or reduced root vigor where visible"
        ],
        "evidenceThatLowersConfidence": [
          "root-zone measurements are stable and matched controls share the same conditions",
          "independent tissue/feed evidence supports a specific supply deficiency"
        ]
      },
      {
        "id": "environmental-or-localized-stress",
        "label": "Environmental or localized canopy stress",
        "whyPlausible": "Temperature, airflow, light distribution and other localized conditions can produce stress patterns that overlap with nutrient symptoms.",
        "evidenceThatRaisesConfidence": [
          "symptoms map to one zone",
          "recent setpoint/equipment change precedes the pattern",
          "matched root-zone chemistry differs little between affected and unaffected plants"
        ],
        "evidenceThatLowersConfidence": [
          "pattern follows tissue age across the entire crop",
          "environmental measurements are spatially uniform while nutrition/root-zone evidence diverges"
        ]
      }
    ],
    "discriminatingEvidence": [
      "Record tissue age, organ position, distribution and progression before naming a cause.",
      "Compare feed and root-zone pH/EC using consistent methods.",
      "Review irrigation/moisture history and root condition.",
      "Compare affected and unaffected zones for temperature, humidity, airflow and light context.",
      "Use laboratory/tissue analysis where appropriate and authorized when the decision requires stronger evidence."
    ],
    "boundary": "This activity teaches differential reasoning. It does not diagnose a crop, prescribe a nutrient correction, or authorize pesticide, HVAC, electrical, irrigation-system or other controlled operational changes."
  }
