          "id": "alternative",
          "label": "Alternative explanation",
          "type": "text",
          "required": true,
          "unit": null
        },
        {
          "id": "nextEvidence",
          "label": "Discriminating evidence needed",
          "type": "text",
          "required": true,
          "unit": null
        },
