{
  "schemaVersion": 1,
  "site": "https://dtfseeds.com",
  "description": "Independent DTFSeeds release resources. Resource builds are isolated; production serialization is scoped to the resource and any explicitly shared publisher mechanism. Routes become authoritative independent publishers only after their production path is proven and gateway orchestration is enabled.",
  "globalBuildPaths": [
    "site/deployment/release-resources.json",
    "scripts/plan-dtfseeds-resource-release.mjs",
    "scripts/package-dtf-public-resource.py",
    "scripts/verify-dtf-public-resource-artifact.py",
    "scripts/assemble-wordpress-resource-v2.py",
    "scripts/public_suite_resource_ownership.py",
    "scripts/assemble-wordpress-suite-resource-aware.py",
    "scripts/package-public-suite-wordpress-resource-aware.py",
    "scripts/test-public-suite-resource-ownership.py",
    "scripts/test-dtf-resource-release-system.mjs",
    ".github/workflows/build-dtfseeds-public-resource.yml",
    ".github/workflows/deploy-dtfseeds-public-resource.yml",
    ".github/workflows/deploy-dtfseeds-wordpress-resource.yml",
    ".github/workflows/dtfseeds-resource-production-gateway.yml"
  ],
  "resources": {
    "high-land": {
      "studioResource": "game.high-land",
      "route": "/games/high-land/",
      "artifactRoot": "games/high-land",
      "productionTarget": "route:/games/high-land/",
      "checkpointTag": "dtfseeds-production-game-high-land",
      "publicSuiteOwnership": "suite",
      "sourcePrefixes": ["apps/high-land-web/"],
      "exactPaths": ["site/deployment/public-apps.json"],
      "requiredFiles": ["games/high-land/index.html"],
      "verifyMarker": "High Land",
      "publisher": {
        "type": "hostinger-ssh",
        "workflow": "deploy-dtfseeds-public-resource.yml",
        "status": "pilot-manual",
        "remotePathVariable": "HOSTINGER_HIGH_LAND_PATH"
      }
    },
    "high-iq": {
      "studioResource": "game.high-iq",
      "route": "/games/high-iq/",
      "artifactRoot": "games/high-iq",
      "productionTarget": "route:/games/high-iq/",
      "checkpointTag": "dtfseeds-production-game-high-iq",
      "publicSuiteOwnership": "resource",
      "sourcePrefixes": ["games/high-iq/", "site/public-route-patch/games/high-iq/"],
      "exactPaths": ["site/deployment/public-apps.json"],
      "requiredFiles": [
        "games/high-iq/index.html",
        "games/high-iq/app.js",
        "games/high-iq/app-v3.js",
        "games/high-iq/game-core.mjs",
        "games/high-iq/high-iq.css",
        "games/high-iq/high-iq-v3.css",
        "games/high-iq/data/manifest.json"
      ],
      "verifyMarker": "Build your High IQ run",
      "publisher": {
        "type": "wordpress-transactional-resource",
        "workflow": "deploy-dtfseeds-wordpress-resource.yml",
        "status": "pilot-manual",
        "orchestration": "gateway-managed",
        "coordinator": "dtfseeds-resource-production-gateway.yml",
        "sharedProductionTarget": "wordpress:temporary-code-snippets-bridge"
      }
    },
    "seed-man-platformer": {
      "studioResource": "game.seed-man-platformer",
      "route": "/games/seed-man-platformer/",
      "artifactRoot": "games/seed-man-platformer",
      "productionTarget": "route:/games/seed-man-platformer/",
      "checkpointTag": "dtfseeds-production-game-seed-man-platformer",
      "publicSuiteOwnership": "resource",
      "sourcePrefixes": [
        "games/seed-man-platformer/",
        "site/public-route-patch/games/seed-man-platformer/",
        "scripts/prepare-seed-man-combat-release.mjs",
        "scripts/prepare-seed-man-world-five-combat.mjs",
        "scripts/prepare-seed-man-world-five-runtime.mjs",
        "scripts/publish-seed-man-route-via-wordpress.mjs",
        ".github/workflows/publish-seed-man-production.yml",
        ".github/workflows/seed-man-world-five-live.yml"
      ],
      "exactPaths": ["site/deployment/public-apps.json"],
      "requiredFiles": [
        "games/seed-man-platformer/index.html",
        "games/seed-man-platformer/world-five-v1.js",
        "games/seed-man-platformer/combat-browser-v1.js",
        "games/seed-man-platformer/enemy-attacks-browser-v1.js",
        "games/seed-man-platformer/enemy-attacks.js",
        "games/seed-man-platformer/data/campaign.json",
        "games/seed-man-platformer/data/levels-12-15.json"
      ],
      "verifyMarker": "Sprout Run",
      "publisher": {
        "type": "wordpress-dedicated-route",
        "workflow": "publish-seed-man-production.yml",
        "status": "production",
        "orchestration": "dedicated",
        "sharedProductionTarget": "wordpress:seed-man-route"
      }
    }
  }
}