{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thc-grow-hub.local/schemas/source-registry.schema.json",
  "title": "THC Grow Hub Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicationId", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "publicationId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sourceType", "verificationStatus", "supportsLessonIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "array", "items": { "type": "string" } },
          "organization": { "type": "string" },
          "publicationYear": { "type": ["integer", "null"], "minimum": 1800 },
          "url": { "type": ["string", "null"] },
          "doi": { "type": ["string", "null"] },
          "sourceType": {
            "enum": ["peer-reviewed", "government", "standards", "extension", "textbook", "manufacturer", "other"]
          },
          "verificationStatus": {
            "enum": ["pending", "verified", "replace", "removed"]
          },
          "supportsLessonIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
