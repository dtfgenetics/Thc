{
  "schemaVersion": 1,
  "defaults": {
    "settleMs": 650,
    "navigationTimeoutMs": 30000,
    "maxHorizontalOverflowPx": 2,
    "minimumBodyTextLength": 20,
    "failOnConsoleError": true,
    "failOnPageError": true,
    "failOnSameOriginRequestFailure": true,
    "viewports": {
      "desktop": {
        "width": 1440,
        "height": 900
      },
      "mobile": {
        "width": 390,
        "height": 844,
        "isMobile": true,
        "hasTouch": true
      }
    }
  },
  "games": {
    "high-iq": {
      "requiredSelectors": [
        "#main-content",
        "#challenge-title",
        "#start-quiz",
        "#daily-start",
        "#lock-answer"
      ],
      "requiredText": [
        "High IQ — Test Higher Cognition",
        "200",
        "approved questions",
        "Start challenge",
        "Play Daily 10",
        "Missed-question review"
      ]
    },
    "high-land": {
      "requiredSelectors": [
        "#root"
      ],
      "requiredText": [
        "High Land: The Sweet Escape",
        "Play on This Device",
        "Create Online Room",
        "Join a Room"
      ]
    },
    "weedopolis": {
      "requiredText": [
        "Weedopolis",
        "Bud Bucks",
        "Start Session",
        "Load",
        "New Game"
      ]
    },
    "seed-man-platformer": {
      "requiredText": [
        "Seed Man"
      ]
    },
    "strain-showdown": {
      "requiredSelectors": [
        "#familyScreen",
        "#battleScreen",
        "#endTurnButton",
        "#rulesButton"
      ],
      "requiredText": [
        "Strain Showdown",
        "96-card",
        "Choose your family",
        "End Turn",
        "How to Play"
      ],
      "prepare": {
        "command": "node",
        "args": [
          "games/strain-showdown/scripts/build-browser-bundle.mjs"
        ]
      },
      "generatedRuntime": [
        "site/public-route-patch/games/strain-showdown/data/browser-bundle.json"
      ]
    },
    "protect-the-plants": {
      "requiredSelectors": [
        "#app",
        "#toast",
        "#plantOverlay"
      ],
      "requiredText": [
        "Burn Buds",
        "15×15",
        "two-player strategy",
        "room codes",
        "rematches",
        "mobile play"
      ]
    },
    "crossword": {
      "requiredText": [
        "Crossword"
      ]
    },
    "who-took-it": {
      "requiredText": [
        "Who Took It"
      ]
    },
    "thc-u-know": {
      "requiredText": [
        "THC U Know"
      ]
    },
    "kush-kings-chess": {
      "requiredText": [
        "Kush Kings"
      ]
    },
    "terpocalypse": {
      "requiredText": [
        "Terpocalypse"
      ]
    },
    "phenoquest": {
      "requiredText": [
        "PhenoQuest"
      ]
    },
    "ganjumanji": {
      "requiredText": [
        "Ganjumanji"
      ]
    },
    "thc-rpg": {
      "requiredText": [
        "THC RPG"
      ]
    },
    "high-life": {
      "requiredSelectors": [
        "#setup-panel",
        "#game-panel",
        "#results-panel"
