{
  "schemaVersion": 1,
  "profiles": {
    "repo-control": {
      "commands": [
        "node --check scripts/orchestrator.mjs",
        "node --check scripts/orchestrator-plan-job.mjs",
        "node scripts/orchestrator-epic.mjs --manifest=configuration/orchestrator/example-epic-manifest.json",
        "node --check scripts/orchestrator/epics.mjs",
        "node -e \"JSON.parse(require('fs').readFileSync('configuration/orchestrator/agent-contract.schema.json','utf8'))\"",
        "node --check scripts/orchestrator/repo-contract.mjs",
        "node --check scripts/orchestrator-epic.mjs",
        "node --check scripts/orchestrator/core.mjs",
        "node --check scripts/orchestrator/resources.mjs",
        "node --check scripts/orchestrator/routing.mjs",
        "node --check scripts/orchestrator/repositories.mjs",
        "node --check scripts/orchestrator/executor.mjs",
        "node --check scripts/orchestrator-executor.mjs",
        "node --check scripts/orchestrator/audit.mjs",
        "node --check scripts/orchestrator-audit.mjs",
        "node scripts/test-worker-orchestrator.mjs",
        "npm run verify:portfolio",
        "npm run verify:navigation"
      ],
      "requiresExactHead": true
    },
    "games-general": {
      "commands": [
        "npm run games:preflight"
      ],
      "requiresExactHead": true,
      "liveVerification": false
    },
    "high-land": {
      "commands": [
        "npm run test:high-land",
        "npm run build:high-land",
        "node scripts/verify-browser-tool-policy.mjs",
        "npm run games:preflight"
      ],
      "requiresExactHead": true,
      "liveVerification": true,
      "liveRoute": "https://dtfseeds.com/games/high-land/"
    },
    "growlens": {
      "commands": [
        "npm run verify:growlens"
      ],
      "requiresExactHead": true,
      "liveVerification": true
    },
    "high-iq": {
      "commands": [
        "npm run hiq:validate",
        "npm run games:preflight"
      ],
      "requiresExactHead": true,
      "liveVerification": true
    },
    "public-release": {
      "commands": [
        "npm run verify:navigation",
        "npm run verify:release-integrity"
      ],
      "requiresExactHead": true,
      "liveVerification": true,
      "liveCommand": "npm run verify:release-integrity:live"
    },
    "content-data": {
      "commands": [
        "npm run verify:portfolio",
        "npm run verify:navigation"
      ],
      "requiresExactHead": true
    }
  },
  "routing": {
    "preferMatchingProfile": true,
    "exact": {
      "platform.repo-control": "repo-control",
      "platform.release-control": "public-release",
      "platform.site-shell": "public-release",
      "app.growlens": "growlens",
      "content.education": "content-data",
      "content.genetics": "content-data",
      "commerce.shop": "public-release",
      "page.home": "public-release",
      "page.learn": "content-data",
      "page.game-hub": "public-release"
    },
    "prefix": {
      "game.": "games-general",
      "page.": "content-data",
      "app.": "repo-control",
      "content.": "content-data",
      "commerce.": "public-release"
    },
    "fallback": "repo-control"
  }
}
