{
  "schemaVersion": 1,
  "id": "grower-conversations",
  "title": "Grower Conversations",
  "type": "conversation-card-deck",
  "status": "browser-deck-alpha",
  "route": "/games/grower-conversations/",
  "modes": ["physical-deck", "browser-deck", "discord-prompt"],
  "machineData": {
    "categories": "games/grower-conversations/data/categories.json",
    "promptBank": "games/grower-conversations/data/prompt-bank.json",
    "validator": "node games/grower-conversations/scripts/validate-prompt-bank.mjs",
    "cards": 96,
    "categoriesCount": 8,
    "cardsPerCategory": 12,
    "depths": ["easy", "reflective", "technical"],
    "cardsPerDepth": 32
  },
  "browserRuntime": {
    "path": "site/public-route-patch/games/grower-conversations",
    "categoryFilter": true,
    "depthFilter": true,
    "noRepeatDraws": true,
    "filteredDeckReset": true,
    "clipboardPromptCopy": true,
    "selfHosted": true
  },
  "materializationRule": "Each category contains 12 prompts. Positions 1-4 are Easy, 5-8 Reflective, and 9-12 Technical. IDs are gc-{category}-{01..12}.",
  "releaseGates": {
    "prompt-bank-complete": true,
    "duplicate-check": true,
    "distribution-check": true,
    "browser-deck": true,
    "digital-sync-check": true,
    "science-review-where-applicable": false,
    "safety-review": false,
    "editorial-review": false,
    "print-proof": false
  }
}
