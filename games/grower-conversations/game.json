{
  "schemaVersion": 1,
  "id": "grower-conversations",
  "title": "Grow Room Confessions",
  "type": "conversation-card-deck",
  "status": "production-alignment",
  "route": "/games/grower-conversations/",
  "modes": [
    "physical-deck",
    "browser-deck",
    "discord-prompt"
  ],
  "machineData": {
    "categories": "games/grower-conversations/data/categories.json",
    "promptBank": "games/grower-conversations/data/prompt-bank.json",
    "validator": "node games/grower-conversations/scripts/validate-prompt-bank.mjs",
    "cards": 96,
    "categoriesCount": 8,
    "cardsPerCategory": 12,
    "depths": [
      "easy",
      "reflective",
      "technical"
    ],
    "cardsPerDepth": 32,
    "previewCards": 96,
    "previewCategoriesCount": 8,
    "previewCardsPerCategory": 12,
    "productionPromptBank": "games/grower-conversations/data/prompt-bank-v2.json",
    "productionValidator": "node games/grower-conversations/scripts/validate-production-bank.mjs",
    "productionCards": 200,
    "productionCardsPerLane": 25
  },
  "browserRuntime": {
    "path": "site/public-route-patch/games/grower-conversations",
    "categoryFilter": true,
    "depthFilter": true,
    "noRepeatDraws": true,
    "filteredDeckReset": true,
    "clipboardPromptCopy": true,
    "selfHosted": true,
    "visibleCardIds": false,
    "productionTitle": true
  },
  "materializationRule": "Each category contains 12 prompts. Positions 1-4 are Easy, 5-8 Reflective, and 9-12 Technical. IDs are gc-{category}-{01..12}.",
  "releaseGates": {
    "prompt-bank-complete": true,
    "duplicate-check": true,
    "distribution-check": true,
    "browser-deck": true,
    "digital-sync-check": true,
    "science-review-where-applicable": false,
    "safety-review": false,
    "editorial-review": false,
    "print-proof": false,
    "production-spec": true,
    "200-card-production-bank": true,
    "mode-presets": false,
    "keeper-system": false,
    "interaction-tokens": false,
    "production-bank-validator": true,
    "production-bank-editorial-review": false,
    "production-bank-playtest-review": false
  },
  "legacyTitle": "Grower Conversations",
  "tagline": "A conversation game for cultivators, breeders, and growers who have stories.",
  "productionTarget": {
    "promptCards": 200,
    "promptLanes": 8,
    "visibleCardIds": false,
    "intensityLevels": [
      "chill",
      "real",
      "deep"
    ],
    "interactionTokens": [
      "go-deeper",
      "call-it-out",
      "respect"
    ],
    "keeperSystem": true,
    "playModes": [
      "smoke-circle",
      "growers-court",
      "deep-roots",
      "hotbox-debate",
      "chaos-grow",
      "solo-grow-journal"
    ]
  }
}
