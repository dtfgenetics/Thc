{
  "version": "seed-man-visual-runtime-v2",
  "reference": {
    "title": "Seed Man visual asset package",
    "intent": "Translate the locked classic Seed Man target and five authored worlds into deterministic runtime keys while preserving an explicit transition from temporary flat masters to final layered rendering.",
    "style": ["flat-2d-character", "thick-outline", "readable-silhouettes", "authored-world-art", "bright-elemental-vfx"],
    "characterContract": "classic-seed-man-oval-v1",
    "currentCharacterStatus": "temporary-green-armored-replacement-pending",
    "activeWorldRenderer": "seed-man-authored-flat-background-v1",
    "worldRendererTarget": "seed-man-three-world-v2",
    "finalWorldLayerCount": 7
  },
  "worlds": {
    "greenhouse-valley": {
      "label": "Greenhouse Valley",
      "accent": "#69e55b",
      "transitionBackground": "world.greenhouse-valley.background",
      "layers": [
        {"key":"sky","depth":-80,"parallax":0.04},
        {"key":"far-bg","depth":-60,"parallax":0.14},
        {"key":"mid-bg","depth":-40,"parallax":0.32},
        {"key":"near-bg","depth":-20,"parallax":0.58},
        {"key":"gameplay","depth":0,"parallax":1},
        {"key":"foreground","depth":20,"parallax":1.08},
        {"key":"vfx","depth":40,"parallax":1}
      ],
      "materials": ["grass", "dirt", "wood", "metal"],
      "setPieces": ["glass-domes", "irrigation-lines", "trellises", "cultivation-beds", "distant-hills"],
      "requiredFx": ["leaf-motes", "water-mist", "collect-burst", "checkpoint-glow"]
    },
    "forest-ruins": {
      "label": "Forest Ruins",
      "accent": "#38c96a",
      "transitionBackground": "world.forest-ruins.background",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["grass", "dirt", "stone", "wood"],
      "setPieces": ["ancient-columns", "giant-roots", "collapsed-bridges", "temple-canopy", "shafts-of-light"]
    },
    "desert-canyon": {
      "label": "Desert Canyon",
      "accent": "#ff8b42",
      "transitionBackground": "world.desert-canyon.background",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["sand", "stone", "metal"],
      "setPieces": ["red-mesas", "sandstone-arches", "solar-towers", "updrafts", "heat-haze"]
    },
    "frozen-peaks": {
      "label": "Frozen Peaks",
      "accent": "#54cfff",
      "transitionBackground": "world.frozen-peaks.background",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["ice", "stone", "metal"],
      "setPieces": ["ice-spires", "crystal-caverns", "frozen-bridges", "glacier-gate", "snow-gusts"]
    },
    "eco-city": {
      "label": "Eco City",
      "accent": "#70f27b",
      "transitionBackground": "world.eco-city.background",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["grass", "metal", "stone"],
      "setPieces": ["grow-towers", "conveyors", "reactor-pipes", "rooftop-cultivation", "stormy-skyline"]
    }
  },
  "player": {
    "targetCharacter": "classic-seed-man-oval-v1",
    "phenotypes": {
      "plant": {"durationMs":0,"projectile":"plant-shot","effect":"pierce","vfx":"plant-aura"},
      "fire": {"durationMs":30000,"projectile":"fire-shot","effect":"burn","vfx":"fire-aura"},
      "electric": {"durationMs":30000,"projectile":"electric-shot","effect":"chain","chainTargets":3,"vfx":"electric-aura"},
      "ice": {"durationMs":30000,"projectile":"ice-shot","effect":"freeze","freezeSeconds":1.8,"vfx":"ice-aura"}
    },
    "requiredAnimations": ["idle", "walk", "run", "jump", "fall", "land", "attack", "hit", "victory"],
    "animationStatus": "classic-family-needed"
  },
  "enemyFamilies": {
    "plant": {"drop":"plant","telegraph":"green-leaf-energy"},
    "fire": {"drop":"fire","telegraph":"orange-embers"},
    "electric": {"drop":"electric","telegraph":"yellow-arcs"},
    "ice": {"drop":"ice","telegraph":"cyan-crystals"}
  },
  "bosses": [
    {"key":"overgrown-guardian","world":"greenhouse-valley","phases":3},
    {"key":"ancient-dryad","world":"forest-ruins","phases":3},
    {"key":"scorchroot-titan","world":"desert-canyon","phases":3},
    {"key":"frostbite-colossus","world":"frozen-peaks","phases":3},
    {"key":"eco-sentinel","world":"eco-city","phases":3},
    {"key":"blight-king","world":"eco-city","phases":4,"finalBoss":true,"weaknessCycle":["plant","fire","electric","ice"]}
  ],
  "hud": {
    "fixedToCamera": true,
    "required": ["seeds", "progress", "jumps", "phenotype", "falls", "time", "best", "pause", "restart"]
  },
  "assetPolicy": {
    "publicApiUsesManifestKeys": true,
    "allowRawFilenameReferences": false,
    "textureFormats": ["png", "webp"],
    "collisionOwnedBySimulation": true,
    "rendererOwnsGameplayState": false,
    "temporaryFlattenedWorldBackgroundsAllowed": true,
    "finalLayeredWorldsRequired": true
  }
}
