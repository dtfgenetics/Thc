{
  "version": "seed-man-visual-runtime-v1",
  "reference": {
    "title": "Seed Man visual asset package",
    "intent": "Translate the approved reference boards into deterministic runtime keys instead of filename-coupled rendering.",
    "style": ["lush", "high-contrast", "readable-silhouettes", "2.5d-platformer", "bright-elemental-vfx"],
    "characterContract": "approved-green-armored-plant-hero-v1"
  },
  "worlds": {
    "greenhouse-valley": {
      "label": "Greenhouse Valley",
      "accent": "#69e55b",
      "layers": [
        {"key":"sky","depth":-80,"parallax":0.04},
        {"key":"far-bg","depth":-60,"parallax":0.14},
        {"key":"mid-bg","depth":-40,"parallax":0.32},
        {"key":"near-bg","depth":-20,"parallax":0.58},
        {"key":"gameplay","depth":0,"parallax":1},
        {"key":"foreground","depth":20,"parallax":1.08},
        {"key":"vfx","depth":40,"parallax":1}
      ],
      "materials": ["grass", "dirt", "stone", "metal"],
      "setPieces": ["glass-domes", "waterfalls", "greenhouse-frames", "giant-trees", "hanging-vines"],
      "requiredFx": ["leaf-motes", "water-mist", "collect-burst", "checkpoint-glow"]
    },
    "forest-ruins": {
      "label": "Forest Ruins",
      "accent": "#38c96a",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["grass", "dirt", "stone"],
      "setPieces": ["ancient-columns", "roots", "collapsed-bridges", "giant-canopy"]
    },
    "desert-canyon": {
      "label": "Desert Canyon",
      "accent": "#ff8b42",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["sand", "stone", "metal"],
      "setPieces": ["mesas", "arches", "ruins", "heat-vents"]
    },
    "frozen-peaks": {
      "label": "Frozen Peaks",
      "accent": "#54cfff",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["ice", "stone", "metal"],
      "setPieces": ["ice-spires", "floating-ice", "frost-caves", "snow-gusts"]
    },
    "eco-city": {
      "label": "Eco City",
      "accent": "#70f27b",
      "layers": ["sky", "far-bg", "mid-bg", "near-bg", "gameplay", "foreground", "vfx"],
      "materials": ["grass", "metal", "stone"],
      "setPieces": ["eco-towers", "waterfalls", "solar-structures", "green-transit"]
    }
  },
  "player": {
    "phenotypes": {
      "plant": {"durationMs":0,"projectile":"plant-shot","vfx":"plant-aura"},
      "fire": {"durationMs":30000,"projectile":"fire-shot","vfx":"fire-aura"},
      "electric": {"durationMs":30000,"projectile":"electric-shot","vfx":"electric-aura"},
      "ice": {"durationMs":30000,"projectile":"ice-shot","vfx":"ice-aura"}
    },
    "animations": {
      "idle": {"minFrames":6},
      "run": {"minFrames":8},
      "jump": {"minFrames":3},
      "fall": {"minFrames":2},
      "land": {"minFrames":4},
      "crouch": {"minFrames":2},
      "attack": {"minFrames":6},
      "hurt": {"minFrames":4},
      "victory": {"minFrames":8},
      "transform": {"minFrames":10}
    }
  },
  "enemyFamilies": {
    "plant": {"drop":"plant","telegraph":"green-leaf-energy"},
    "fire": {"drop":"fire","telegraph":"orange-embers"},
    "electric": {"drop":"electric","telegraph":"yellow-arcs"},
    "ice": {"drop":"ice","telegraph":"cyan-crystals"}
  },
  "bosses": [
    {"key":"overgrown-guardian","world":"greenhouse-valley","phenotype":"plant"},
    {"key":"scorchroot-titan","world":"desert-canyon","phenotype":"fire"},
    {"key":"frostbite-colossus","world":"frozen-peaks","phenotype":"ice"},
    {"key":"eco-sentinel","world":"eco-city","phenotype":"electric"}
  ],
  "hud": {
    "fixedToCamera": true,
    "required": ["portrait", "health", "energy", "lives", "seed-count", "phenotype-slots", "pause"]
  },
  "assetPolicy": {
    "publicApiUsesManifestKeys": true,
    "allowRawFilenameReferences": false,
    "modelFormat": "glb",
    "textureFormats": ["webp", "png"],
    "atlasMetadata": "json",
    "collisionOwnedBySimulation": true,
    "rendererOwnsGameplayState": false
  }
}
