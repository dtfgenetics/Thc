{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfgenetics.local/schemas/rirt-contract.schema.json",
  "title": "DTF Cross-System Contract",
  "type": "object",
  "required": ["id", "producer", "consumer", "type", "version", "verification"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "type": {"enum": ["schema", "api", "artifact", "route", "asset", "deployment", "behavior"]},
    "version": {"type": "string", "minLength": 1},
    "compatibility": {"enum": ["backward-compatible", "forward-compatible", "bidirectional", "breaking", "unknown"]},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_notes": {"type": "string"}
  },
  "additionalProperties": false
}
