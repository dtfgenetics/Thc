{
  "name": "THC Development and Browser QA",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm ci && npm install --no-save --package-lock=false playwright@1.58.2 && npx playwright install chromium",
  "forwardPorts": [
    4173,
    5173
  ],
  "portsAttributes": {
    "4173": {
      "label": "High Land Preview",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "THC High Land Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
