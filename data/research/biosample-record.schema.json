{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/research/biosample-record-1.0.0.json",
  "title": "DTF public BioSample metadata record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_id",
    "biosample",
    "organism",
    "attributes",
    "provenance"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 3
    },
    "source_id": {
      "type": "string",
      "minLength": 3
    },
    "biosample": {
      "type": "string",
      "pattern": "^SAM[NED][0-9]+$"
    },
    "sample_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sra_sample_accession": {
      "type": [
        "string",
        "null"
      ]
    },
    "bioproject": {
      "type": [
        "string",
        "null"
      ]
    },
    "organism": {
      "type": "string",
      "minLength": 2
    },
    "package": {
      "type": [
        "string",
        "null"
      ]
    },
    "cultivar": {
      "type": [
        "string",
        "null"
      ]
    },
    "tissue": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "geo_loc_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sex": {
      "type": [
        "string",
        "null"
      ]
    },
    "accession_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "grin_puid": {
      "type": [
        "string",
        "null"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "submission": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "retrieved_at"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "source_record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
