{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dtfseeds.com/schemas/research/experiment-record-1.0.0.json",
  "title":"DTF plant breeding/phenotyping experiment record",
  "type":"object",
  "additionalProperties":false,
  "required":["record_id","source_id","experiment_id","title","study_type","biological_material","design","provenance"],
  "properties":{
    "record_id":{"type":"string","minLength":3},
    "source_id":{"type":"string","minLength":3},
    "experiment_id":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":3},
    "study_type":{"type":"string","minLength":2},
    "description":{"type":["string","null"]},
    "location":{"type":["object","null"],"additionalProperties":true},
    "start_date":{"type":["string","null"]},
    "end_date":{"type":["string","null"]},
    "environment":{"type":["object","null"],"additionalProperties":true},
    "design":{
      "type":"object",
      "additionalProperties":true,
      "properties":{
        "design_type":{"type":["string","null"]},
        "replicate_count":{"type":["integer","null"],"minimum":1},
        "block_count":{"type":["integer","null"],"minimum":1},
        "randomization":{"type":["string","null"]},
        "experimental_unit":{"type":["string","null"]},
        "plants_per_unit":{"type":["integer","null"],"minimum":1}
      }
    },
    "biological_material":{
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":true,"required":["material_id"],"properties":{
        "material_id":{"type":"string"},
        "accession_id":{"type":["string","null"]},
        "puid":{"type":["string","null"]},
        "plant_id":{"type":["string","null"]},
        "seed_lot_id":{"type":["string","null"]},
        "pedigree":{"type":["string","null"]}
      }}
    },
    "treatments":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "observation_variables":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "protocols":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "standards":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "provenance":{"type":"object","additionalProperties":true,"required":["source_url","retrieved_at"],"properties":{
      "source_url":{"type":"string","format":"uri"},
      "retrieved_at":{"type":"string","format":"date"},
      "source_record_id":{"type":["string","null"]}
    }}
  }
}
