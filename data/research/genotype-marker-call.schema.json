{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/research/genotype-marker-call-1.0.0.json",
  "title": "DTF genotype marker call",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id","source_id","sample_id","marker_panel","marker_id","reference_genome","call_method","provenance"],
  "properties": {
    "record_id":{"type":"string","minLength":3},
    "source_id":{"type":"string","minLength":3},
    "sample_id":{"type":"string","minLength":1},
    "accession_id":{"type":["string","null"]},
    "marker_panel":{"type":"string","minLength":3},
    "marker_id":{"type":"string","minLength":1},
    "reference_genome":{"type":"string","minLength":2},
    "chromosome":{"type":["string","null"]},
    "position":{"type":["integer","null"],"minimum":1},
    "alleles":{"type":"array","items":{"type":"string"},"minItems":0},
    "genotype_call":{"type":["string","null"]},
    "call_method":{"type":"string","minLength":2},
    "missing_allele_discovery_counts":{"type":["object","null"],"additionalProperties":true},
    "provenance":{
      "type":"object",
      "additionalProperties":false,
      "required":["source_url","retrieved_at"],
      "properties":{
        "source_url":{"type":"string","format":"uri"},
        "retrieved_at":{"type":"string","format":"date"},
        "source_record_id":{"type":["string","null"]},
        "rights_status":{"type":["string","null"]}
      }
    }
  }
}
