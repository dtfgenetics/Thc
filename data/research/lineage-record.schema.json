{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dtfseeds.com/schemas/research/lineage-record-1.0.0.json",
  "title":"DTF lineage, cross and selection record",
  "type":"object",
  "additionalProperties":false,
  "required":["record_id","source_id","progeny_id","generation","breeding_method","parents","provenance"],
  "properties":{
    "record_id":{"type":"string","minLength":3},
    "source_id":{"type":"string","minLength":3},
    "progeny_id":{"type":"string","minLength":1},
    "progeny_accession_id":{"type":["string","null"]},
    "generation":{"type":"string","minLength":1},
    "breeding_method":{"type":"string","minLength":1},
    "parents":{
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["role","material_id"],"properties":{
        "role":{"enum":["female","male","maternal","paternal","self","unknown"]},
        "material_id":{"type":"string","minLength":1},
        "accession_id":{"type":["string","null"]},
        "plant_id":{"type":["string","null"]},
        "generation":{"type":["string","null"]}
      }}
    },
    "cross_date":{"type":["string","null"]},
    "population_id":{"type":["string","null"]},
    "seed_lot_id":{"type":["string","null"]},
    "selection_events":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "progeny_count":{"type":["integer","null"],"minimum":0},
    "provenance":{"type":"object","additionalProperties":true,"required":["source_url","retrieved_at"],"properties":{
      "source_url":{"type":"string","format":"uri"},
      "retrieved_at":{"type":"string","format":"date"},
      "source_record_id":{"type":["string","null"]}
    }}
  }
}
