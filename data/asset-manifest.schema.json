{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/dtf-asset-manifest.schema.json",
  "title": "DTF Master Asset Manifest",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"type": "string"},
    "updated": {"type": "string"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "project_id", "name", "asset_type", "status", "canonical_location", "version"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 3},
          "project_id": {"type": "string", "minLength": 2},
          "name": {"type": "string", "minLength": 1},
          "asset_type": {"enum": ["image", "infographic", "document", "data", "audio", "video", "board", "card", "print", "code-pointer", "other"]},
          "status": {"enum": ["draft", "review", "approved", "release-candidate", "released", "superseded", "quarantined"]},
          "canonical_location": {"type": "string", "minLength": 1},
          "working_location": {"type": ["string", "null"]},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"]},
          "width_px": {"type": ["integer", "null"], "minimum": 1},
          "height_px": {"type": ["integer", "null"], "minimum": 1},
          "dpi": {"type": ["number", "null"], "minimum": 1},
          "source_or_creator": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]},
          "approval_basis": {"type": ["string", "null"]},
          "used_by": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
