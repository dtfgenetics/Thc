{
  "schemaVersion": 1,
  "description": "Resource-oriented coordination map for fast parallel work across DTFSeeds. This registry classifies code/content by independently testable or releasable resource without creating hard development locks.",
  "principles": {
    "development": "optimistic",
    "locks": "none",
    "overlap": "advisory-until-integration",
    "productionSerialization": "same-resource-only",
    "resume": "explicit-only"
  },
  "sourceRegistries": [
    "data/project-registry.json",
    "site/deployment/public-apps.json",
    "site/deployment/release-lanes.json",
    "site/deployment/release-resources.json"
  ],
  "staticResources": [
    {
      "id": "platform.repo-control",
      "kind": "platform",
      "prefixes": [".github/", ".agents/", "docs/", "scripts/studio/"],
      "exactPaths": ["AGENTS.md", "CLAUDE.md", "package.json", "package-lock.json", "data/project-work-lanes.json", "data/project-registry.json", "data/studio-resources.json"],
      "productionTargets": []
    },
    {
      "id": "platform.release-control",
      "kind": "release-control",
      "prefixes": [],
      "exactPaths": [
        "site/deployment/release-lanes.json",
        "site/deployment/release-resources.json",
        "scripts/plan-dtfseeds-release.mjs",
        "scripts/plan-dtfseeds-resource-release.mjs",
        "scripts/run-workflow-and-wait.sh",
        "scripts/validate-public-game-release-integrity.mjs",
        "scripts/promote-public-game-routes-via-wordpress.mjs",
        "scripts/repair-game-route-redirects-via-wordpress.mjs",
        "scripts/public_suite_resource_ownership.py",
        "scripts/assemble-wordpress-suite-resource-aware.py",
        "scripts/package-public-suite-wordpress-resource-aware.py",
        "scripts/assemble-wordpress-resource-v2.py",
        ".github/workflows/dtfseeds-production-gateway.yml",
        ".github/workflows/dtfseeds-resource-production-gateway.yml",
        ".github/workflows/build-dtfseeds-public-resource.yml",
        ".github/workflows/deploy-dtfseeds-public-resource.yml",
        ".github/workflows/deploy-dtfseeds-wordpress-resource.yml",
        ".github/workflows/game-release-integrity.yml",
        ".github/workflows/game-route-directory-swap-ci.yml",
        ".github/workflows/wordpress-game-route-directory-swap.yml",
        ".github/workflows/wordpress-game-route-production-v2.yml",
        ".github/workflows/wordpress-canonical-watch.yml",
        ".github/workflows/wordpress-canonical-deploy.yml",
        ".github/workflows/wordpress-canonical-production.yml",
        ".github/workflows/deploy-public-suite-wordpress-v2.yml",
        ".github/workflows/deploy-games-suite-lock-recovery.yml",
        ".github/workflows/deploy-thc-learning-center-expansion-v1.yml",
        ".github/workflows/wordpress-harvest-outdoor-v6-production.yml"
      ],
      "productionTargets": ["shared:release-control"]
    },
    {
      "id": "platform.site-shell",
      "kind": "shared-ui",
      "prefixes": ["site/design-system/"],
      "exactPaths": ["data/public-navigation.json", "site/public-route-patch/games/dtf-route.css", "site/public-route-patch/games/dtf-shell.css"],
      "productionTargets": ["shared:site-shell"]
    },
    {
      "id": "page.home",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/home.html"],
      "productionTargets": ["route:/"]
    },
    {
      "id": "page.about",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/about.html"],
      "productionTargets": ["route:/about/"]
    },
    {
      "id": "page.blog",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/blog.html"],
      "productionTargets": ["route:/blog/"]
    },
    {
      "id": "page.community",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/community.html"],
      "productionTargets": ["route:/community/"]
    },
    {
      "id": "page.contact",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/contact.html"],
      "productionTargets": ["route:/contact/"]
    },
    {
      "id": "page.gallery",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/gallery.html"],
      "productionTargets": ["route:/gallery/"]
    },
    {
      "id": "page.learn",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/wordpress/pages/learn.html"],
      "productionTargets": ["route:/learn/"]
    },
    {
      "id": "page.game-hub",
      "kind": "page",
      "prefixes": [],
      "exactPaths": ["site/public-route-patch/games/index.html", "site/deployment/public-apps.json"],
      "productionTargets": ["route:/games/"]
    },
    {
      "id": "app.growlens",
      "kind": "application",
      "prefixes": ["apps/growlens-web/", "site/public-route-patch/growlens/"],
      "exactPaths": [],
      "productionTargets": ["route:/growlens/"]
    },
    {
      "id": "app.grow-doc",
      "kind": "application",
      "prefixes": ["site/public-route-patch/thc-grow-doc/"],
      "exactPaths": ["site/public-route-patch/assets/release-source-revisions/thc-grow-doc.txt"],
      "productionTargets": ["route:/thc-grow-doc/"]
    },
    {
      "id": "app.plant-atlas",
      "kind": "application",
      "prefixes": ["site/public-route-patch/atlas/", "apps/growlens-web/public/atlas/", "site/public-route-patch/assets/images/atlas/"],
      "exactPaths": [],
      "productionTargets": ["route:/atlas/"]
    },
    {
      "id": "content.education",
      "kind": "content-system",
      "prefixes": ["content/", "configuration/", "assets/education/", "site/public-route-patch/learn/", "site/wordpress/education/", "site/wordpress/assets/infographics/", "staging/harvest-asset-upload/", "ops/asset-bridge/lighting/"],
      "exactPaths": [],
      "productionTargets": ["route:/learn/"]
    },
    {
      "id": "content.genetics",
      "kind": "content-system",
      "prefixes": ["data/genetics/", "site/wordpress/genetics/", "site/wordpress/products/", "site/wordpress/assets/genetics/", ".tmp/strain-card-b64/"],
      "exactPaths": ["site/wordpress/pages/seeds.html", "site/design-system/dtf-genetics-owner-v1.css"],
      "productionTargets": ["route:/seeds/"]
    },
    {
      "id": "commerce.shop",
      "kind": "commerce",
      "prefixes": ["site/wordpress/shop/"],
      "exactPaths": ["site/wordpress/pages/shop.html"],
      "productionTargets": ["route:/shop/"]
    }
  ],
  "dynamicResources": [
    {
      "idTemplate": "game.{id}",
      "kind": "game",
      "patterns": [
        "^games/([^/]+)/",
        "^site/public-route-patch/games/([^/]+)/",
        "^apps/([^/]+)-web/"
      ],
      "excludeIds": ["growlens"],
      "productionTargetTemplate": "route:/games/{id}/"
    }
  ]
}
