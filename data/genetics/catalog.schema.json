{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/genetics-catalog.schema.json",
  "title": "DTF Genetics Catalog",
  "type": "object",
  "required": ["schemaVersion", "brand", "updated", "lines"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "brand": { "const": "DTF Genetics" },
    "updated": { "type": "string", "format": "date" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "lineage", "parents", "publicDescription", "claimsPolicy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["parent-line", "active-breeding-line", "flagship-breeding-line", "released-line", "archived-line"] },
          "lineage": { "type": "string", "minLength": 3 },
          "parents": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["role", "name"],
              "properties": {
                "role": { "enum": ["seed-parent", "pollen-parent", "parent-unspecified"] },
                "name": { "type": "string", "minLength": 1 },
                "catalogId": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "floweringWindowWeeks": {
            "type": ["object", "null"],
            "required": ["minimum", "maximum", "qualifier"],
            "properties": {
              "minimum": { "type": "integer", "minimum": 1 },
              "maximum": { "type": "integer", "minimum": 1 },
              "qualifier": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "breedingDirection": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
          "publicDescription": { "type": "string", "minLength": 1 },
          "claimsPolicy": {
            "type": "object",
            "required": ["phenotypeGuarantee", "yieldGuarantee", "potencyGuarantee", "finishDateGuarantee"],
            "properties": {
              "phenotypeGuarantee": { "const": false },
              "yieldGuarantee": { "const": false },
              "potencyGuarantee": { "const": false },
              "finishDateGuarantee": { "const": false }
            },
            "additionalProperties": false
          },
          "releaseNotes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
